    <select id="getUserFavoritePage" resultMap="getUserFavoritePageMap">
        select ufw.id, ufw.user_id, ufw.voc_id, ufw.voc_content, ufw.selected, vm.id as vm_id, vm.inter_content, vm.type
        from (select uf.id, uf.user_id, uf.voc_id, uf.voc_content, selected
              from user_favorite uf
              where uf.user_id = #{userId} and uf.is_deleted = 0
             ) as ufw
                 inner join voc_meaning vm on ufw.voc_id = vm.voc_id
        where ufw.voc_content like #{keyword}
    </select>


</mapper>
