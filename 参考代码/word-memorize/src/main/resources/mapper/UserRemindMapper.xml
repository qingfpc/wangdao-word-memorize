<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper SYSTEM "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cskaoyan.wordmemorize.dao.mapper.UserRemindMapper">

    <resultMap id="userRemindMap" type="com.cskaoyan.wordmemorize.dao.entity.UserRemindDO" autoMapping="true">
        <id column="id" property="id"/>
    </resultMap>
    <select id="getUserRemindInfo" resultType="com.cskaoyan.wordmemorize.dao.entity.UserRemindDO">
        select ur.id, ur.user_id, ur.remind_time, ur.message_status, ur.user_name
        from user_remind ur
        where ur.user_id=#{userId}
    </select>


</mapper>
