<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- LevelMapper.xml -->
<mapper namespace="com.cskaoyan.wordmemorize.dao.mapper.LevelMapper">
    <select id="selectLevelsWithGoods" resultType="map">
        SELECT l.*,
        g.id AS relation_goods_id
        FROM level l
        LEFT JOIN goods g ON l.level_value = g.value AND g.type = 2 AND g.is_deleted = 0
        WHERE l.is_deleted = 0
        ORDER BY l.level_value ASC
    </select>
</mapper>

