<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cskaoyan.wordmemorize.dao.mapper.UserVocAISituationOptionMapper">
    <select id="selectBySituationId" resultType="com.cskaoyan.wordmemorize.dao.entity.UserVocAISituationOptionDO">
        SELECT id, situation_id, name, description
        FROM user_voc_ai_situation_option
        WHERE is_deleted = 0 AND situation_id = #{situationId}
    </select>
</mapper>