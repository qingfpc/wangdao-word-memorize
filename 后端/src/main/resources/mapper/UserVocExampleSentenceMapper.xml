<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cskaoyan.wordmemorize.dao.mapper.UserVocExampleSentenceMapper">
    <select id="selectByUserIdAndVocId" resultType="com.cskaoyan.wordmemorize.dao.entity.UserVocExampleSentenceDO">
        SELECT * FROM user_voc_sentence
        WHERE user_id = #{userId} AND voc_id = #{vocId} AND is_deleted = 0
    </select>
</mapper> 